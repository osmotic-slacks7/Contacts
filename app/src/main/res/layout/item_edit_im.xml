<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_im_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/activity_margin">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/contact_im_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/contact_im_type"
        android:layout_marginBottom="@dimen/medium_margin"
        style="@style/GoogleOutlinedField">

        <org.fossify.commons.views.MyEditText
            android:id="@+id/contact_im"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/im"
            android:lines="1"
            android:maxLines="1"
            android:singleLine="true"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/bigger_text_size" />

    </com.google.android.material.textfield.TextInputLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/contact_im_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/contact_im_layout"
        android:layout_alignBottom="@+id/contact_im_layout"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="@dimen/medium_margin"
        android:paddingEnd="@dimen/medium_margin"
        android:text="@string/skype"
        android:textSize="@dimen/bigger_text_size" />

</RelativeLayout>
