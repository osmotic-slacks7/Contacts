<resources>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Google Contacts style outlined text field for the edit screen. Colors are set at runtime (updateOutlinedFields). -->
    <style name="GoogleOutlinedField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/outlined_field_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/outlined_field_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/outlined_field_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/outlined_field_corner_radius</item>
        <item name="hintEnabled">true</item>
    </style>

</resources>
